{
  "name": "@codepilot/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@codepilot/agent-core": "workspace:*",
    "@codepilot/contracts": "workspace:*",
    "@codepilot/github": "workspace:*",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@codepilot/config": "workspace:*",
    "@types/jest": "29.5.14",
    "jest": "29.7.0",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
