{
  "name": "codepilot-ai",
  "version": "0.0.1",
  "private": true,
  "description": "Repository-aware AI coding agent with controlled execution and human review.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build && pnpm -r --filter \"./apps/**\" run build",
    "dev": "pnpm -r --parallel --filter \"./apps/**\" run dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r --if-present run test:integration",
    "setup": "pnpm install && pnpm db:generate && pnpm -r --filter \"./packages/**\" run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@codepilot/config": "workspace:*",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
