# Copy to .env and fill in. Never commit real values.

# --- Database / queue (matches docker-compose.yml) ---
DATABASE_URL=postgresql://codepilot:codepilot@localhost:5432/codepilot?schema=public
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- GitHub App (Week 2) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- LLM provider (Week 4) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_TOKENS_PER_TASK=200000

# --- Worker / sandbox ---
WORKER_CONCURRENCY=2
WORKSPACE_ROOT=./.workspaces
MAX_REPAIR_ATTEMPTS=2
