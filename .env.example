# Copy to .env and fill in. Never commit real values.

# --- Database / queue (matches docker-compose.yml) ---
DATABASE_URL=postgresql://codepilot:codepilot@localhost:5432/codepilot?schema=public
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
# Public dashboard origin. The browser reaches the API through its /api proxy.
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=168

# --- Web ---
# Where the Next.js server proxies /api requests.
API_ORIGIN=http://localhost:4000

# --- GitHub App (see docs/api/github-app-setup.md) ---
# Optional in development (GitHub routes return 503), required in production.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# --- Planning (Claude API) ---
# Without a key the worker still runs, but tasks fail at PLANNING (or GENERATING_PATCH) with a clear reason.
ANTHROPIC_API_KEY=
# Must be listed in MODEL_PRICING (packages/agent-core/src/planning/pricing.ts).
PLANNING_MODEL=claude-opus-5-5
PLANNING_EFFORT=high
# Model calls per planning round; invalid output is fed back to the model in between.
PLANNING_MAX_ATTEMPTS=2
PLANNING_MAX_OUTPUT_TOKENS=16000

# --- Patch generation (Claude API) ---
# Implements the approved plan as a commit on a codepilot/... branch in a disposable workspace.
PATCH_MODEL=claude-opus-5-5
PATCH_EFFORT=high
PATCH_MAX_ATTEMPTS=2
PATCH_MAX_OUTPUT_TOKENS=32000
# Largest file the agent may edit or create, and the most lines one patch may change.
PATCH_MAX_FILE_KB=256
PATCH_MAX_CHANGED_LINES=1500
# Identity on agent commits. The default address uses the reserved .invalid domain on purpose.
PATCH_AUTHOR_NAME=CodePilot AI
PATCH_AUTHOR_EMAIL=codepilot@codepilot.invalid

# Input plus output tokens one task may spend across all of its model calls (planning and patches).
TASK_TOKEN_BUDGET=400000
MODEL_TIMEOUT_SECONDS=300

# --- Worker / sandbox ---
# The worker reuses GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY_PATH above to clone repositories.
WORKER_CONCURRENCY=2
WORKSPACE_ROOT=./.workspaces
MAX_REPAIR_ATTEMPTS=2

# --- Repository analysis ---
MAX_REPOSITORY_SIZE_MB=1024
GIT_TIMEOUT_SECONDS=180
SNAPSHOTS_TO_KEEP=5

# --- Orchestration ---
# Wall-clock limits per stage; a stage that runs longer fails the task.
ANALYZE_TIMEOUT_SECONDS=600
PLAN_TIMEOUT_SECONDS=900
PATCH_TIMEOUT_SECONDS=1200
# How often a running job checks whether its task was cancelled.
CANCELLATION_POLL_MS=2000
