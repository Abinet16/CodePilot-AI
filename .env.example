# Copy to .env and fill in. Never commit real values.

# --- Database / queue (matches docker-compose.yml) ---
DATABASE_URL=postgresql://codepilot:codepilot@localhost:5432/codepilot?schema=public
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
# Public dashboard origin. The browser reaches the API through its /api proxy.
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=168

# --- Web ---
# Where the Next.js server proxies /api requests.
API_ORIGIN=http://localhost:4000

# --- GitHub App (see docs/api/github-app-setup.md) ---
# Optional in development (GitHub routes return 503), required in production.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# --- LLM provider (Week 4) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_TOKENS_PER_TASK=200000

# --- Worker / sandbox ---
WORKER_CONCURRENCY=2
WORKSPACE_ROOT=./.workspaces
MAX_REPAIR_ATTEMPTS=2
